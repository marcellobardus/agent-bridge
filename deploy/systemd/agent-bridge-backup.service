[Unit]
Description=Agent Bridge encrypted DB backup
After=agent-bridge.service

[Service]
Type=oneshot
User=agent-bridge
Group=agent-bridge
# files land as agent-bridge:bridge-backup 0640 (setgid dir + UMask 0027)
ExecStart=/opt/agent-bridge/current/deploy/backup.sh
# bridge.cli loads settings (and so both credentials) for every subcommand, `backup snapshot` included
LoadCredential=pepper:/etc/agent-bridge/credentials/pepper
LoadCredential=totp_kek:/etc/agent-bridge/credentials/totp_kek
ReadWritePaths=/var/backups/agent-bridge /var/lib/agent-bridge
ReadOnlyPaths=/etc/agent-bridge/backup-recipients.txt
UMask=0027
Nice=10
IOSchedulingClass=idle
MemoryMax=96M
MemorySwapMax=0
TasksMax=32
OOMScoreAdjust=500
# network: none needed
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
